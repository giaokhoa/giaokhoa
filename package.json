{
  "name": "giaokhoa-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "seed": "pnpm --filter @giaokhoa/api build && pnpm --filter @giaokhoa/api seed:review",
    "format": "prettier --write .",
    "format:docs": "prettier --write \"**/*.{md,mdx}\"",
    "format:docs:check": "prettier --check \"**/*.{md,mdx}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
