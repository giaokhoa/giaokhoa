# Secrets và cấu hình máy cá nhân; chỉ commit file mẫu.
.env
.env.*
!.env.example
!.env.*.example
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-local.yaml

# Ignore IDE-generated settings; keep shared Java compiler settings.
/backend/.settings/*
!/backend/.settings/org.eclipse.jdt.core.prefs

# Worktrees độc lập, build artifacts.
.worktrees/
**/target/
**/node_modules/
**/.next/
**/coverage/
