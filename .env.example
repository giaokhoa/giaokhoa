# Sao chép thành .env (không commit). Dùng: set -a; . ./.env; set +a
# Chỉ là mẫu: thay mọi giá trị "replace-with-..." trước khi khởi động.
# Gateway/alias của issuer được tạo ở T004; .devcontainer/compose.yml giữ nguyên.
APP_ORIGIN=http://giaokhoa.localhost:3000
OIDC_ISSUER_URI=http://auth.giaokhoa.localhost:8081/realms/giaokhoa
OIDC_CLIENT_ID=giaokhoa-web
OIDC_CLIENT_SECRET=replace-with-confidential-web-client-secret
KEYCLOAK_AUTHZ_AUDIENCE=giaokhoa-api
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080

# Client provisioner riêng, quyền tối thiểu; KHÔNG dùng secret của web client.
KEYCLOAK_PROVISIONER_CLIENT_ID=giaokhoa-provisioner
KEYCLOAK_PROVISIONER_CLIENT_SECRET=replace-with-provisioner-client-secret

# Runtime DB role không sở hữu bảng, không BYPASSRLS; chỉ dùng cho ứng dụng.
SPRING_DATASOURCE_URL=jdbc:postgresql://app-db:5432/giaokhoa
SPRING_DATASOURCE_USERNAME=giaokhoa_runtime
SPRING_DATASOURCE_PASSWORD=replace-with-runtime-db-password
# Flyway migration role riêng; cùng database, quyền DDL theo migration.
SPRING_FLYWAY_USER=giaokhoa_migrator
SPRING_FLYWAY_PASSWORD=replace-with-migration-db-password

# SMTP cho môi trường dev/test khi Mailpit được bổ sung ở T004.
MAIL_HOST=mailpit
MAIL_PORT=1025

# Chỉ dành cho test với services bên ngoài Testcontainers; KHÔNG trỏ vào DEV.
TEST_DATABASE_URL=jdbc:postgresql://replace-with-test-db-host:5432/giaokhoa_test
TEST_KEYCLOAK_BASE_URL=http://replace-with-test-keycloak-host:8080

# Đặt đúng project Compose hiện đang chạy DevContainer (không tạo stack/volumes khác).
COMPOSE_PROJECT_NAME=replace-with-existing-devcontainer-project
