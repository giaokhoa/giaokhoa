{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV", "PORT", "VITE_API_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "env": ["VITE_API_URL"]
    },
    "start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV", "PORT"]
    },
    "reset": { "cache": false },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@giaokhoa/api#test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@giaokhoa/api#test:int": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@giaokhoa/api#test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@giaokhoa/database#test:int": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL"],
      "cache": false
    }
  }
}
