{
  "name": "Giáo khoa",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/giaokhoa",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": true,
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "mounts": [
    "source=github-cli-config,target=/home/vscode/.config/gh,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "GH_CONFIG_DIR": "/home/vscode/.config/gh"
  },
  "waitFor": "postCreateCommand",
  "postCreateCommand": "sudo mkdir -p /home/vscode/.config/gh && sudo chown -R vscode:vscode /home/vscode/.config/gh && npx -y playwright@1.64.1 install --with-deps chromium"
}
