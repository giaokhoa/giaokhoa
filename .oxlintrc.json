{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },
  "jsPlugins": ["@shadcn/lint"],
  "overrides": [
    {
      "files": ["apps/web/**", "packages/ui/src/**"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "shadcn/no-restyle": "off"
      }
    },
    {
      "files": ["apps/api/**"],
      "env": {
        "node": true
      }
    }
  ]
}
