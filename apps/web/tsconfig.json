{
  "extends": "@giaokhoa/config/tsconfig/react.json",
  "compilerOptions": {
    "paths": {
      "@giaokhoa/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "#features/*": [
        "./src/features/*"
      ],
      "#utils/*": [
        "./src/utils/*"
      ],
      "#config/*": [
        "./src/config/*"
      ]
    },
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ]
  },
  "include": [
    "src",
    ".react-router/types/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts"
  ]
}
