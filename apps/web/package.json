{
  "name": "@giaokhoa/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./app/components/*",
    "#features/*": "./app/features/*",
    "#lib/*": "./app/lib/*"
  },
  "scripts": {
    "tikz:sync": "node ./scripts/sync-tikz-runtime.mjs",
    "predev": "pnpm tikz:sync",
    "dev": "react-router dev",
    "prebuild": "pnpm tikz:sync",
    "build": "react-router build",
    "start": "pnpm start:prod",
    "typecheck": "react-router typegen && tsc",
    "test": "node --test test/*.test.mjs",
    "start:prod": "PORT=${PORT:-3001} react-router-serve ./build/server/index.js"
  },
  "dependencies": {
    "@giaokhoa/editor": "workspace:*",
    "@giaokhoa/shared": "workspace:*",
    "@giaokhoa/ui": "workspace:*",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@tanstack/react-table": "^9.2.6",
    "axios": "^1.20.0",
    "better-auth": "1.7.7",
    "dompurify": "^3.4.16",
    "isbot": "^5.2.2",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
