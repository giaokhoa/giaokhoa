{
  "name": "@giaokhoa/mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "start:local": "node --env-file=../api/.env dist/index.js",
    "tunnel:doctor": "tunnel-client doctor --profile giaokhoa --explain",
    "tunnel": "tunnel-client run --profile giaokhoa"
  },
  "dependencies": {
    "@giaokhoa/application": "workspace:*",
    "@giaokhoa/database": "workspace:*",
    "@giaokhoa/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
