DATABASE_URL=postgres://postgres:postgres@localhost:5432/giaokhoa
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-at-least-16-chars
# Optional: dedicated key material for encrypting TOTP secrets at rest
# (AES-256-GCM). When unset, the key is derived from JWT_SECRET.
MFA_ENCRYPTION_KEY=change-me-mfa-encryption-key
PORT=3000
NODE_ENV=development

# Better Auth mặc định tắt; chỉ khai báo secret riêng khi bật tính năng.
# Không đặt BETTER_AUTH_SECRET rỗng: bộ kiểm tra môi trường yêu cầu >= 32 ký tự
# kể cả khi tính năng đang tắt. Không dùng lại JWT_SECRET.
BETTER_AUTH_ENABLED=false
# BETTER_AUTH_SECRET=replace-with-secret-at-least-32-chars
<redacted>
BETTER_AUTH_TRUSTED_ORIGINS=

# Rate limits per IP per minute (tighten with care: schools behind NAT share one public IP)
RATE_LIMIT_PER_MINUTE=3000
RATE_LIMIT_AUTH_PER_MINUTE=300
# Comma-separated origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173
