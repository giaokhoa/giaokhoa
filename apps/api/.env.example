NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/giaokhoa
S3_ENDPOINT=http://s3mock:9090
S3_REGION=us-east-1
S3_BUCKET=giaokhoa-assets
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
FILE_ORPHAN_TTL_HOURS=24
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3001
# Google OAuth redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# RESEND_FROM_EMAIL must be a verified sender/domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
