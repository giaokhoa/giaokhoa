{
  "name": "@giaokhoa/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "nest build",
    "start": "nest start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:cov": "vitest run --coverage",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "auth:generate": "auth generate --config ./src/auth/auth.config.ts --output ../../packages/database/src/schema/auth.generated.ts -y && node ./scripts/patch-auth-schema.mjs",
    "db:generate": "pnpm --filter @giaokhoa/database db:generate",
    "db:migrate": "pnpm --filter @giaokhoa/database db:migrate",
    "db:push": "pnpm --filter @giaokhoa/database db:push",
    "db:studio": "pnpm --filter @giaokhoa/database db:studio",
    "reset": "node ./scripts/reset.mjs",
    "preimages:gc": "pnpm exec turbo run build --filter=@giaokhoa/api",
    "images:gc": "node ./scripts/images-gc.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@giaokhoa/application": "workspace:*",
    "@giaokhoa/database": "workspace:*",
    "@giaokhoa/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "katex": "0.18.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.0",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "auth": "1.7.7",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
