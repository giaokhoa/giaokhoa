{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "tsc",
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      "i18n/**/*.json",
      "modules/curriculum/program-data/**/*",
      "modules/curriculum/program-data-dump/**/*",
      "modules/books/book-data/**/*",
      "modules/paper-grading/assets/*.ttf"
    ],
    "watchAssets": true
  }
}
