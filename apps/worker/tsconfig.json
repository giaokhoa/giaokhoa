{
  "extends": "@giaokhoa/config/tsconfig/nest.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "paths": {
      "@giaokhoa/db/control-plane": [
        "../../packages/db/dist/control-plane.d.ts"
      ],
      "@giaokhoa/db/repositories/*": [
        "../../packages/db/dist/repositories/*.d.ts"
      ],
      "@giaokhoa/db/test-support": [
        "../../packages/db/dist/test-support/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts"
  ]
}
