{
  "name": "@giaokhoa/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./migrations": {
      "types": "./src/migrations.ts",
      "default": "./dist/migrations.js"
    },
    "./*": {
      "types": "./src/repositories/*.ts",
      "default": "./dist/repositories/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "reset": "node ./scripts/reset.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "authz:bootstrap": "node ./scripts/bootstrap-admin.mjs",
    "test:int": "vitest run"
  },
  "dependencies": {
    "@giaokhoa/application": "workspace:*",
    "@giaokhoa/shared": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
