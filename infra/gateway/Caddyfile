http://giaokhoa.localhost:3000 {
	@backend path /api /api/* /oauth2/* /login /login/* /logout /actuator/*
	handle @backend {
		reverse_proxy app:8080 {
			header_up X-Forwarded-Port 3000
			header_up -X-Forwarded-Prefix
		}
	}
	handle {
		reverse_proxy app:3001
	}
}

http://auth.giaokhoa.localhost:8081 {
	reverse_proxy keycloak:8080 {
		header_up X-Forwarded-Port 8081
		header_up -X-Forwarded-Prefix
	}
}
