<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- JdbcTemplate là dependency dùng chung do Spring quản lý; không sao chép template/connection pool. -->
    <Match>
        <Class name="com.giaokhoa.identity.security.JdbcOidcSessionRegistry"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Spring quản lý vòng đời JdbcTemplate và thread-bound EntityManager; không sao chép dependency được inject. -->
    <Match>
        <Class name="com.giaokhoa.authorization.operation.IdempotencyService"/>
        <Field name="~(jdbc|entities)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate, IdempotencyService); không sao chép khi inject vào service. -->
    <Match>
        <Class name="com.giaokhoa.authorization.operation.AuthorizationOperationService"/>
        <Field name="~(jdbc|idempotency)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate, PolicyGraphWriter, KeycloakProvisioningClient); không sao chép khi inject vào reconciler/worker. -->
    <Match>
        <Class name="com.giaokhoa.authorization.projection.ProjectionReconciler"/>
        <Field name="~(jdbc|writer|directory)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate, CurrentIdentityClient, AuthorizationOperationService); không sao chép khi inject vào synchronizer. -->
    <Match>
        <Class name="com.giaokhoa.identity.eligibility.IdentityEligibilitySynchronizer"/>
        <Field name="~(jdbc|identities|operations)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate, CurrentIdentityClient); không sao chép khi inject vào service bootstrap. -->
    <Match>
        <Class name="com.giaokhoa.identity.IdentityService"/>
        <Field name="~(jdbc|identities)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate); không sao chép khi inject vào registrar. -->
    <Match>
        <Class name="com.giaokhoa.identity.IssuedStudentRegistrar"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.giaokhoa.authorization.projection.ProjectionWorker"/>
        <Field name="~(jdbc|reconciler)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate); không sao chép khi inject vào resolver/fence/controller mẫu. -->
    <Match>
        <Class name="com.giaokhoa.authorization.fence.DependencyManifestResolver"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.giaokhoa.authorization.fence.AuthorizationFence"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.giaokhoa.verification.SampleActionController"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate); không sao chép khi inject vào controller trạng thái operation. -->
    <Match>
        <Class name="com.giaokhoa.authorization.operation.OperationController"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Fixture test giữ JdbcTemplate của context test để seed dữ kiện; không sao chép template/connection pool. -->
    <Match>
        <Class name="com.giaokhoa.support.NativeGateFixture"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate); không sao chép khi inject vào helper transaction workspace. -->
    <Match>
        <Class name="com.giaokhoa.tenancy.data.WorkspaceTransaction"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate); không sao chép khi inject vào thư mục workspace. -->
    <Match>
        <Class name="com.giaokhoa.tenancy.WorkspaceDirectory"/>
        <Field name="jdbc"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Dependency singleton do Spring quản lý (JdbcTemplate, PolicyGraphWriter); không sao chép khi inject vào executor. -->
    <Match>
        <Class name="com.giaokhoa.authorization.decision.ProtectedActionExecutor"/>
        <Field name="~(jdbc|writer)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- JPA cần entity không final; các constructor này chỉ gán field, không giữ tài nguyên hay gọi code ngoài. -->
    <Match>
        <Class name="~com\.giaokhoa\.authorization\.model\.Authorization(Operation|Projection)"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- Test cố ý truyền null trong assertThrows để xác nhận validation của constructor. -->
    <Match>
        <Class name="com.giaokhoa.authorization.model.AuthorizationModelTest"/>
        <Method name="~lambda\$requiredArraysRejectNullBeforePersisting\$[0-9]+"/>
        <Bug pattern="NP_NULL_PARAM_DEREF_NONVIRTUAL"/>
    </Match>
</FindBugsFilter>
